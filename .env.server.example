SUPABASE_SERVICE_ROLE_KEY=server-only-secret
HOST=127.0.0.1
PORT=8090
ACCESS_MODE=local
# Production: ACCESS_MODE=proxy, a private origin behind an authenticated staff proxy,
# PROXY_ACCESS_SECRET=at-least-32-random-characters and APP_ORIGIN=https://your-private-origin.
